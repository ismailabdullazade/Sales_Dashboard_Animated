{
  "name": "Sales Midnight",
  "dataColors": [
    "#38BDF8",
    "#A78BFA",
    "#34D399",
    "#FBBF24",
    "#F472B6",
    "#FB7185",
    "#22D3EE",
    "#C084FC"
  ],
  "background": "#0B1220",
  "foreground": "#E2E8F0",
  "tableAccent": "#38BDF8",
  "good": "#34D399",
  "neutral": "#FBBF24",
  "bad": "#FB7185",
  "maximum": "#38BDF8",
  "center": "#A78BFA",
  "minimum": "#1E293B",
  "null": "#64748B",
  "textClasses": {
    "callout": {
      "fontSize": 30,
      "fontFace": "Segoe UI Semibold",
      "color": "#F8FAFC"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#E2E8F0"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#E2E8F0"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#94A3B8"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0B1220"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#111B2E"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1F2D47"
              }
            },
            "radius": 14
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left"
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#1F2D47"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#1F2D47"
              }
            }
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#94A3B8"
              }
            }
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#E2E8F0"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "fontSize": 30
          }
        ],
        "categoryLabels": [
          {
            "show": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": false
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "background": {
              "solid": {
                "color": "#0F1829"
              }
            }
          }
        ]
      }
    }
  }
}