{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/bookmark/2.1.0/schema.json",
  "displayName": "Trend - Revenue view",
  "name": "bm_revenue",
  "options": {
    "applyOnlyToTargetVisuals": true,
    "targetVisualNames": [
      "trend_profit",
      "trend_revenue"
    ],
    "suppressData": true
  },
  "explorationState": {
    "version": "1.0",
    "activeSection": "overview",
    "sections": {
      "overview": {
        "visualContainers": {
          "trend_profit": {
            "singleVisual": {
              "visualType": "lineChart",
              "display": {
                "mode": "hidden"
              }
            }
          },
          "trend_revenue": {
            "singleVisual": {
              "visualType": "stackedAreaChart"
            }
          }
        }
      }
    }
  }
}