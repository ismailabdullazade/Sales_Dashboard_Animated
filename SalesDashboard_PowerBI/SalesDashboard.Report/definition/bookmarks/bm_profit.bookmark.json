{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/bookmark/2.1.0/schema.json",
  "displayName": "Trend - Profit view",
  "name": "bm_profit",
  "options": {
    "applyOnlyToTargetVisuals": true,
    "targetVisualNames": [
      "trend_revenue",
      "trend_profit"
    ],
    "suppressData": true
  },
  "explorationState": {
    "version": "1.0",
    "activeSection": "overview",
    "sections": {
      "overview": {
        "visualContainers": {
          "trend_revenue": {
            "singleVisual": {
              "visualType": "stackedAreaChart",
              "display": {
                "mode": "hidden"
              }
            }
          },
          "trend_profit": {
            "singleVisual": {
              "visualType": "lineChart"
            }
          }
        }
      }
    }
  }
}