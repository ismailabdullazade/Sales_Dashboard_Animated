table Sales
	lineageTag: e5121482-3929-4d22-a255-accb1a466884

	measure 'Total Revenue' = SUM(Sales[Revenue])
		formatString: \$#,0
		displayFolder: Core
		lineageTag: 6bad6be2-8e7a-46e9-9f19-950499dd251d

	measure 'Total Cost' = SUM(Sales[Cost])
		formatString: \$#,0
		displayFolder: Core
		lineageTag: d7a7a3cc-8c3d-4f16-9293-de8fc88b2875

	measure 'Total Profit' = [Total Revenue] - [Total Cost]
		formatString: \$#,0
		displayFolder: Core
		lineageTag: 7dabe929-c4a3-44bf-86cd-75e9bb049a79

	measure 'Profit Margin %' = DIVIDE([Total Profit], [Total Revenue])
		formatString: 0.0%
		displayFolder: Core
		lineageTag: 70eb9a0a-9626-4ae6-85e8-18fac0433cbd

	measure 'Total Units' = SUM(Sales[Units])
		formatString: #,0
		displayFolder: Core
		lineageTag: 14aa4e71-9d3c-4dec-80a6-1f933d6c51e3

	measure 'Avg Unit Price' = DIVIDE([Total Revenue], [Total Units])
		formatString: \$#,0.00
		displayFolder: Core
		lineageTag: 1919e93a-d117-45ad-8988-93101c593af5

	measure 'Revenue Share %' = DIVIDE([Total Revenue], CALCULATE([Total Revenue], ALLSELECTED(Sales)))
		formatString: 0.0%
		displayFolder: Core
		lineageTag: e4163207-d094-4996-82f0-ee99731c9452

	measure 'Revenue PY' = CALCULATE([Total Revenue], SAMEPERIODLASTYEAR('Calendar'[Date]))
		formatString: \$#,0
		displayFolder: Time Intelligence
		lineageTag: 5071950e-adec-4f11-bd83-6e77af67d461

	measure 'Revenue YoY %' = DIVIDE([Total Revenue] - [Revenue PY], [Revenue PY])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Time Intelligence
		lineageTag: 59001ac9-4063-49bc-a5b0-0a2d35d14880

	measure 'Revenue YTD' = TOTALYTD([Total Revenue], 'Calendar'[Date])
		formatString: \$#,0
		displayFolder: Time Intelligence
		lineageTag: 5b4c8012-ede7-4d0c-bfb8-8309fadb8908

	column OrderDate
		dataType: dateTime
		formatString: Long Date
		lineageTag: bef7e268-ffe9-46ab-a058-1ccace1d62e0
		summarizeBy: none
		sourceColumn: OrderDate

		annotation UnderlyingDateTimeDataType = Date

	column Category
		dataType: string
		lineageTag: b91dddd9-1389-4372-a341-738c837a7935
		summarizeBy: none
		sourceColumn: Category

	column Product
		dataType: string
		lineageTag: 89be9c1c-8eb5-440f-96f4-488157241955
		summarizeBy: none
		sourceColumn: Product

	column Region
		dataType: string
		lineageTag: 24114258-751b-4c83-89a0-47dc4ac87fc0
		summarizeBy: none
		sourceColumn: Region

	column Units
		dataType: int64
		formatString: #,0
		lineageTag: b766ff10-b437-4db5-a511-49bbe060a724
		summarizeBy: sum
		sourceColumn: Units

	column Revenue
		dataType: double
		formatString: \$#,0.00
		lineageTag: d9090b89-0655-4096-8f1a-8a1d93d20470
		summarizeBy: sum
		sourceColumn: Revenue

	column Cost
		dataType: double
		formatString: \$#,0.00
		lineageTag: 7608d942-5d11-4a9d-9e6c-9992b5fb12e0
		summarizeBy: sum
		sourceColumn: Cost

	partition Sales = m
		mode: import
		source =
				let
				    Source = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)),
				    Table = Table.FromRows(Source, {"OrderDate", "Category", "Product", "Region", "Units", "Revenue", "Cost"}),
				    Typed = Table.TransformColumnTypes(Table, {{"OrderDate", type date}, {"Category", type text}, {"Product", type text}, {"Region", type text}, {"Units", Int64.Type}, {"Revenue", type number}, {"Cost", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

